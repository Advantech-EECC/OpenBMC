From c177eceee3ae4305c083add2fc9eb145136f0579 Mon Sep 17 00:00:00 2001
From: Ramiro Oliveira <ramiro.oliveira@advantech.com>
Date: Fri, 6 Mar 2026 09:49:11 +0000
Subject: [PATCH] Add EEPROM and I2C Slave

Signed-off-by: Ramiro Oliveira <ramiro.oliveira@advantech.com>
---
 arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
index 95abeaa32e19..752e14e326bb 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
@@ -460,6 +460,19 @@ &i2c9 {
 	multi-master;
 	aspeed,hw-timeout-ms = <300>;
 	status = "okay";
+
+        /* Baseboard FRU */
+        eeprom@50 {
+                compatible = "atmel,24c64";
+                reg = <0x50>;
+        };
+
+        ipmb9@10 {
+                compatible = "ipmb-dev";
+		reg = <(0x10 | I2C_OWN_SLAVE_ADDRESS)>;
+		i2c-protocol;
+
+        };
 };
 
 &i2c10 {
